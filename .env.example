# Copy to .env and adjust. install.sh generates this for you automatically.

# A long random string. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the database and generated files live.
DATA_DIR=instance

# Ollama daemon.
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=600

# Web server. Port 5001 keeps it clear of the chat app on 5000.
HOST=0.0.0.0
PORT=5001

# Where finished builds are written (blank => a folder inside DATA_DIR).
BUILDER_OUTPUT_DIR=

# Default builder model (blank => choose one in the UI). Example: builder-web
BUILDER_MODEL=

# Bootstrap admin — applied on first run only, when no users exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
