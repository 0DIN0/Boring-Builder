[Unit]
Description=Boring Builder (local AI project builder)
Documentation=https://github.com/ollama/ollama
# Start after the network is up and, if Ollama runs as a service on this host,
# after it too. The After= line is harmless if ollama.service does not exist.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
# __USER__ / __GROUP__ / paths are filled in by install.sh.
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
# A widened PATH so hardware detection can find nvidia-smi / lspci under systemd.
Environment="PATH=__APP_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/gunicorn --config __APP_DIR__/gunicorn_conf.py wsgi:app
Restart=on-failure
RestartSec=3

# --- Hardening -----------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# Persistent state lives here; keep it writable.
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target
